{
  "name": "opencode-subagent-mcp",
  "version": "0.1.0",
  "description": "Run Claude Code subagents on cheaper opencode models (DeepSeek, opencode Go) via an MCP server, with native subagent parity",
  "keywords": [
    "claude-code",
    "claude",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "opencode",
    "subagents",
    "deepseek",
    "ai-agents"
  ],
  "author": "sebstaq",
  "homepage": "https://github.com/sebstaq/opencode-subagent-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebstaq/opencode-subagent-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sebstaq/opencode-subagent-mcp/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "smoke": "pnpm build && tsx scripts/smoke.ts",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "bin": {
    "opencode-subagent-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  }
}
